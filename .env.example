ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SECRET_KEY=
PRODUCTION=1

# Shared store for inquiries, papers, and admin edits.
# On Vercel this is required. Without it, writes live on a temporary disk and disappear.
# Example: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Razorpay keys so authors can pay the article processing charge on submit-paper.html.
# On Vercel: Project → Settings → Environment Variables (Production, Preview, Development).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Razorpay dashboard webhook for /api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Confirmation email. Use Resend or SMTP. If both are empty, forms still save and skip email.
RESEND_API_KEY=
MAIL_FROM=ICCPP <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
