{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "functions": {
    "server.py": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.iccppglobal.com" }],
      "destination": "https://iccppglobal.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.iccppglobal.com" }],
      "destination": "https://iccppglobal.com/:path*",
      "permanent": true
    }
  ]
}
